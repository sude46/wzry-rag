# ---- LLM / Embedding (OpenAI-compatible) ----
# SiliconFlow is used by default. Any OpenAI-compatible endpoint works.
EMBED_API_KEY=sk-your-key
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
GEN_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional separate LLM endpoint. Leave empty to reuse EMBED_* above.
LLM_API_KEY=
LLM_BASE_URL=

# ---- Redis (session memory + answer cache) ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Retrieval ----
# vector | hybrid | rerank
RETRIEVER=hybrid
COLLECTION=semantic
TOP_K=5
DISTANCE_THRESHOLD=0.6
INDEX_VERSION=v1
PROMPT_VERSION=v2

# ---- MCP ----
# stdio | sse
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8001
